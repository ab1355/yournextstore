# ─── YNS / Stripe (legacy default) ──────────────────────────────────────────
# Remove or leave blank when using a new payment provider below.
YNS_API_KEY=your_api_token_here

# ─── Payment provider selection ──────────────────────────────────────────────
# Set to "polar", "creem", "flexprice", or "x402" to use a new payment provider.
# Leave unset to use the legacy YNS/Stripe proxy (default).
# PAYMENT_PROVIDER=polar

# Public base URL of your deployed store (used for redirect/success URLs).
# NEXT_PUBLIC_APP_URL=https://your-store.example.com

# Product ID mapping (JSON): maps your commerce-kit variant IDs to provider IDs.
# Format: {"<variant_id>": {"polar": "<polar_price_id>", "creem": "<creem_product_id>"}}
# PRODUCT_ID_MAP={}

# ─── Polar.sh (https://polar.sh) ─────────────────────────────────────────────
# POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxx
# POLAR_WEBHOOK_SECRET=whs_xxxxxxxxxxxxxxxxxxxx
# POLAR_SERVER=sandbox            # "sandbox" (default) or "production"
# POLAR_SUCCESS_URL=              # defaults to $NEXT_PUBLIC_APP_URL/checkout/success

# ─── Creem.io (https://creem.io) ─────────────────────────────────────────────
# CREEM_API_KEY=creem_xxxxxxxxxxxxxxxxxxxx
# CREEM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# CREEM_SUCCESS_URL=              # defaults to $NEXT_PUBLIC_APP_URL/checkout/success

# ─── Flexprice (https://flexprice.io) ────────────────────────────────────────
# FLEXPRICE_API_KEY=fp_xxxxxxxxxxxxxxxxxxxx
# FLEXPRICE_API_URL=https://api.flexprice.io/v1
# FLEXPRICE_ENVIRONMENT_ID=env_xxxxxxxxxxxxxxxxxxxx
# FLEXPRICE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx  # Stripe webhook secret
# FLEXPRICE_SUCCESS_URL=          # defaults to $NEXT_PUBLIC_APP_URL/checkout/success

# ─── x402 (https://x402.org) ─────────────────────────────────────────────────
# Pay with USDC on Base using the HTTP 402 payment protocol.
# X402_WALLET_ADDRESS=0xYourWalletAddressHere
# X402_NETWORK=base-sepolia       # "base-sepolia" (default/testnet) or "base" (mainnet)
# X402_FACILITATOR_URL=           # defaults to https://x402.org/facilitator
# X402_SUCCESS_URL=               # defaults to $NEXT_PUBLIC_APP_URL/checkout/success
# X402_CDP_CLIENT_KEY=            # optional: CDP client key for in-browser paywall UI
# X402_APP_NAME=                  # optional: app name shown in paywall UI
